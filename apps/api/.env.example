# Without GEMINI_API_KEY the chat button is simply hidden.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

S3_BUCKET="vyoma-website-assets"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

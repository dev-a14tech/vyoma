MONGODB_URI="mongodb://127.0.0.1:27018/vyoma_website"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="12h"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
